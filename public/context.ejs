  <header class="header-contents">
    <div class="context-header">
        <div class="toastr-msg">
            <span id="toastr-title"></span>
          </div>
      <ul class="header-menu">
        <li class="route-name active-route"> <a href="/dashboard">Dashboard</a> </li>
        <li class="route-name"> <a href="/helper">Help</a></li>
      </ul>
    </div>
  </header>

  <div class="input-route-url">
    <div class="input-group">
      <input type="hidden" id="route-id" value="" />
      <input type="hidden" id="project-id" value="" />
      <input type="hidden" id="project-name" value="" />
      <div class="input-group-prepend">
        <select class="custom-select" id="inputTypeSelect">
          <option value="">Route Type...</option>
          <option value="GET">GET</option>
          <option value="POST">POST</option>
          <option value="PUT">PUT</option>
          <option value="DELETE">DELETE</option>
          <option value="PATCH">PATCH</option>
        </select>
      </div>
      <span class="input-group-text middle-input-part" id="project-url-value"><%= projectUrl %>/project-name</span>
      <input type="text" class="input-field" id="basic-url"  placeholder="/route/name" aria-describedby="basic-addon3">
    </div>
  </div>

  <div class="route-options">

    <div
      id="documentWrapper"
      class="flex-fill">

        <div class="input-option">

          <div class="input-header">
            <div class="input-group-header">
              <input type="checkbox" name="isAuthenticate" id="isAuthenticate" />
              <span class="input-auth">Authenticate</span>

              <span class="swagger-upload">
                <label for="swagger-file-input" class="swagger-upload-label" title="Upload an OpenAPI/Swagger file (YAML or JSON) to generate the schema">
                  <img src="/assets/icons/upload.svg" class="swagger-upload-icon" alt="upload" />
                  Upload OpenAPI
                </label>
                <input type="file" id="swagger-file-input" class="swagger-file-input" accept=".yaml,.yml,.json" disabled />
              </span>

            </div>

          </div>

        </div>

        <div id='documentTextarea'></div>

    </div>

    <div class="show-hints">

      <div class="input-option right-input">
        <div class="input-header">
          <div class="input-group two-button">
            <button type="button" class="input-group-text auth-input-part button-input-part" id="btn-1">Schema</button>

            <button id="show-sample-data" class="input-group-text auth-input-part button-input-part">
              <img src="/assets/icons/sync.svg" class="btn-icon sync-ico">
              Sample
            </button>

            <button type="button" class="input-group-text auth-input-part button-input-part json-action-btn" id="btn-stringify" title="Stringify JSON" disabled>
              <img src="/assets/icons/stringify.svg" class="json-action-icon">
            </button>

            <button type="button" class="input-group-text auth-input-part button-input-part json-action-btn" id="btn-beautify" title="Beautify JSON" disabled>
              <img src="/assets/icons/beautify.svg" class="json-action-icon">
            </button>

          </div>
        </div>
      </div>

      <script src="/vendor/prism/prism.js"  type="text/javascript"></script>

<pre class="show-code">
  <code class="language-javascript" id="code" contenteditable="true"></code>
</pre>
    </div>

  </div>


<div class="clear-both"></div>
